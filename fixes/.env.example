# --- database (defaults work as-is) ---
POSTGRES_USER=kankei
POSTGRES_PASSWORD=kankei
POSTGRES_DB=kankei

# --- LLM (any OpenAI-compatible API, or LLM_PROVIDER=anthropic) ---
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=20
LLM_RETRIES=2
# 1 = never call the network; answer from data/llm_cache only (use this on demo day)
LLM_OFFLINE=0
# bump to invalidate every cached answer on purpose
LLM_CACHE_SCOPE=demo-v1

# --- web ---
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
